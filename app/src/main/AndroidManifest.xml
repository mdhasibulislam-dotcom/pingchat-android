<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 2 (calls): declared now so the manifest is ready. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".PingChatApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PingChat">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PingChat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v3.2.2: Supabase auth deep link (signup confirmation +
                 password reset). The Site URL / Redirect URLs in the
                 Supabase dashboard point here, so tapping an auth email
                 link opens the app (MainActivity imports the session
                 from the link's fragment) instead of a black browser
                 page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.mdhasibulislam.pingchat"
                    android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- FCM push (v3.0.0): receives message/call notifications. FCM only;
             the data layer is Supabase. -->
        <service
            android:name=".data.PingChatMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- v2.0.8: inline reply from the notification shade. -->
        <receiver
            android:name=".data.NotificationReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mdhasibulislam.pingchat.REPLY" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
